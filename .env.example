# Server configuration
PORT=8080
DOMAIN=voice.repozis.ru
ENVIRONMENT=production

# Room settings
ROOM_NAME=main
MAX_USERS=25

# WebRTC configuration
UDP_MIN=50000
UDP_MAX=50100
STUN_SERVERS=stun:stun.l.google.com:19302

# Security
AUTH_TOKEN=your-secret-token-here

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Upload settings
MAX_UPLOAD_SIZE=104857600
